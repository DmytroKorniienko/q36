#version 460

/* Dense f16/bf16 matvec. Accumulates in fp64 with the same sequential order as
 * the CPU reference (q36_tensor_matvec dequant path), so a row dot is
 * bit-exact against the CPU engine. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights {
    uint w[];
};

layout(set = 0, binding = 1) readonly buffer Input {
    float x[];
};

layout(set = 0, binding = 2) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform Push {
    uint in_dim;
    uint out_dim;
    uint n_tok;
    float scale;
} pc;

float weight_at(uint idx) {
    uint word = w[idx >> 1];
    uint hbits = ((idx & 1u) == 0u) ? (word & 0xffffu) : (word >> 16);
#ifdef Q36_BF16
    return uintBitsToFloat(hbits << 16u);
#else
    return unpackHalf2x16(hbits).x;
#endif
}

#ifdef Q36_BF16
float round_bf16(float value) {
    uint bits = floatBitsToUint(value);
    if ((bits & 0x7fffffffu) > 0x7f800000u)
        bits = (bits & 0xffff0000u) | 0x00400000u;
    else
        bits = (bits + 0x7fffu + ((bits >> 16u) & 1u)) & 0xffff0000u;
    return uintBitsToFloat(bits);
}

#endif

void main(void) {
    uint out_row = gl_GlobalInvocationID.x;
    uint tok = gl_GlobalInvocationID.y;
    if (out_row >= pc.out_dim || tok >= pc.n_tok) return;
    double acc = 0.0;
    uint wbase = out_row * pc.in_dim;
    uint xbase = tok * pc.in_dim;
    for (uint i = 0; i < pc.in_dim; i++) {
#ifdef Q36_BF16
        float input_value = round_bf16(x[xbase + i]);
#else
        float input_value = x[xbase + i];
#endif
        acc += double(weight_at(wbase + i)) * double(input_value);
    }
    y[tok * pc.out_dim + out_row] = float(acc) * pc.scale;
}
