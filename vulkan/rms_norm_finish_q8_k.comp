#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer W { float w[]; };
layout(binding = 2) readonly buffer Partial { double partial[]; };
layout(binding = 3) writeonly buffer Y { float y[]; };
layout(binding = 4) writeonly buffer Q8K { uint q8[]; };
layout(push_constant) uniform Push { uint n; uint has_weight; float eps; } pc;

const uint Q8K_WORDS = 74u;

int nearest_int(float fval) {
    /* precise: keep the mul that produces fval from contracting into an fma
     * with this magic-number add, or bytes drift from the CPU quantizer. */
    precise float val = fval + 12582912.0f;
    uint bits = floatBitsToUint(val);
    return int(bits & 0x007fffffu) - 0x00400000;
}

uint pack_i8x4(int a0, int a1, int a2, int a3) {
    return (uint(a0) & 255u)
         | ((uint(a1) & 255u) << 8u)
         | ((uint(a2) & 255u) << 16u)
         | ((uint(a3) & 255u) << 24u);
}

void main(void) {
    uint lid = gl_LocalInvocationID.x, row = gl_WorkGroupID.y;
    uint p = row * 256u + lid;
    /* Keep the original FP64 tree. Each subgroup then normalizes and
     * quantizes one block, including lowest-index max ties and RTE bytes. */
    precise double ss = (partial[p] + partial[p + 128u]) +
                        (partial[p + 64u] + partial[p + 192u]);
    ss += (partial[p + 32u] + partial[p + 160u]) +
          (partial[p + 96u] + partial[p + 224u]);
    for (uint sh = 16u; sh > 0u; sh >>= 1u) {
        uvec2 bits = unpackDouble2x32(ss);
        double other = packDouble2x32(uvec2(subgroupShuffleDown(bits.x, sh),
                                             subgroupShuffleDown(bits.y, sh)));
        if (lid < sh) ss += other;
    }
    uvec2 bits = unpackDouble2x32(ss);
    ss = packDouble2x32(uvec2(subgroupShuffle(bits.x, 0u), subgroupShuffle(bits.y, 0u)));
    float scale = inversesqrt(float(ss / double(pc.n)) + pc.eps);
    uint lane = lid;
    uint base = row * pc.n;
    uint block = gl_WorkGroupID.x;
    uint elem = block * 256u + lane * 8u;
    float v[8];
    float best_abs = 0.0;
    float best_val = 0.0;
    uint best_idx = lane * 8u;
    for (uint j = 0u; j < 8u; j++) {
        v[j] = (x[base + elem + j] * scale) * w[elem + j];
        y[base + elem + j] = v[j];
        if (abs(v[j]) > best_abs) {
            best_abs = abs(v[j]);
            best_val = v[j];
            best_idx = lane * 8u + j;
        }
    }
    float maxabs = subgroupMax(best_abs);
    uint idx = subgroupMin(best_abs == maxabs ? best_idx : 0xffffffffu);
    float maxv = subgroupShuffle(best_val, idx / 8u);
    float iscale = maxv != 0.0 ? float(-127.0 / double(maxv)) : 0.0;
    float d = iscale != 0.0 ? float(1.0 / double(iscale)) : 0.0;
    int qv[8];
    int sum8 = 0;
    for (uint j = 0u; j < 8u; j++) {
        int vq = iscale != 0.0 ? nearest_int(iscale * v[j]) : 0;
        if (vq > 127) vq = 127;
        qv[j] = vq;
        sum8 += vq;
    }
    uint out_base = (row * (pc.n / 256u) + block) * Q8K_WORDS;
    if (lane == 0u) {
        q8[out_base] = floatBitsToUint(d);
        q8[out_base + 1u] = 0u;
    }
    q8[out_base + 2u + 2u * lane] = pack_i8x4(qv[0], qv[1], qv[2], qv[3]);
    q8[out_base + 3u + 2u * lane] = pack_i8x4(qv[4], qv[5], qv[6], qv[7]);
    uint src = (lane & 7u) * 4u;
    int s0 = subgroupShuffle(sum8, src) + subgroupShuffle(sum8, src + 1u);
    int s1 = subgroupShuffle(sum8, src + 2u) + subgroupShuffle(sum8, src + 3u);
    if (lane < 8u)
        q8[out_base + 66u + lane] = (uint(s0) & 0xffffu) | ((uint(s1) & 0xffffu) << 16u);
}
