#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

/* Preserve the signed Q8 values as packed i16 pairs. The verifier applies
 * the original f32 scales after its exact integer sum. */
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 1) writeonly buffer I16 { uint values[]; };
layout(push_constant) uniform Push { uint total_blocks; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint b = i >> 6u;
    if (b >= pc.total_blocks) return;
    uint q = q8[b * 74u + 2u + (i & 63u)];
    values[2u * i] = uint(packInt2x16(i16vec2(bitfieldExtract(int(q), 0, 8),
                                            bitfieldExtract(int(q), 8, 8))));
    values[2u * i + 1u] = uint(packInt2x16(i16vec2(bitfieldExtract(int(q), 16, 8),
                                                 bitfieldExtract(int(q), 24, 8))));
}
