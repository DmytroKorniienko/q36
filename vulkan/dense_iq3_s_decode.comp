#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_GOOGLE_include_directive : require

const uint q36_iq3s_grid[512] = uint[512](
#include "../q36_iq3s_grid_values.inc"
);

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint8_t wb[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

#ifndef Q36_TOKENS
#define Q36_TOKENS 1
#endif

#if Q36_TOKENS > 1
layout(constant_id = 0) const uint N_TOKENS = Q36_TOKENS;
#else
#define N_TOKENS 1
#endif

#define UNROLL [[unroll]]

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    float scale;
#if Q36_TOKENS > 1
    uint n_tok;
#endif
} pc;

#ifndef Q36_ROWS
#define Q36_ROWS 5
#endif
#ifndef Q36_BOUNDS
#define Q36_BOUNDS 1
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;
const uint TAB_IQ3S_GRID = 2592u;

shared uint grid_lut[512];
shared uint sign_lut[16];

uint load_u8(uint off) {
    return uint(wb[off]);
}

uint load_u16(uint off) {
    uint16_t lo = uint16_t(wb[off]);
    uint16_t hi = uint16_t(wb[off + 1u]);
    return uint(lo | (hi << uint16_t(8)));
}

uint load_u32(uint off) {
    return uint(wb[off]) | (uint(wb[off + 1u]) << 8u) |
           (uint(wb[off + 2u]) << 16u) | (uint(wb[off + 3u]) << 24u);
}

int signed_bytes(uint grid, uint signs) {
    /* Odd magnitudes negate by toggling every bit except the low bit. */
    return int(grid ^ sign_lut[signs & 15u]);
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint itid = lid & 7u;
    uint first_row = gl_WorkGroupID.x * ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;
    UNROLL for (uint i = lid; i < 512u; i += 64u)
        grid_lut[i] = q36_iq3s_grid[i];
    if (lid < 16u)
        sign_lut[lid] = (((lid * 0x00204081u) & 0x01010101u) * 254u);
    barrier();

    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        uint qbase = b * Q8K_WORDS + 2u + 8u * itid;
        int qv[N_TOKENS][8];
        float yd[N_TOKENS];
        UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
            uint offset = t * pc.blocks * Q8K_WORDS;
            UNROLL for (uint l = 0u; l < 8u; l++) qv[t][l] = int(q8[offset + qbase + l]);
            yd[t] = uintBitsToFloat(q8[offset + b * Q8K_WORDS]);
        }

        UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            uint base = row * pc.row_bytes + 110u * b;
            uint qh = load_u8(base + 66u + itid);
            uint qs0 = load_u32(base + 2u + 8u * itid);
            uint qs1 = load_u32(base + 6u + 8u * itid);
            uint signs4 = load_u32(base + 74u + 4u * itid);
            /* These 32 byte products sum exactly in f32; packed integer dots
             * preserve the decode result before applying float scales. */
            int sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0;
            UNROLL for (uint l = 0u; l < 4u; l++) {
                uint qs = l < 2u ? qs0 >> (16u * l) : qs1 >> (16u * (l - 2u));
                uint signs = (signs4 >> (8u * l)) & 255u;
                uint grid0 = grid_lut[(qs & 255u) |
                                      ((qh << (8u - 2u * l)) & 256u)];
                uint grid1 = grid_lut[((qs >> 8u) & 255u) |
                                      ((qh << (7u - 2u * l)) & 256u)];
                int weight0 = signed_bytes(grid0, signs);
                int weight1 = signed_bytes(grid1, signs >> 4u);
                UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                    sum[t] += dotPacked4x8EXT(weight0, qv[t][2u * l]);
                    sum[t] += dotPacked4x8EXT(weight1, qv[t][2u * l + 1u]);
                }
            }
            uint sc = load_u8(base + 106u + (itid >> 1u));
            int ls = 2 * int((itid & 1u) == 0u ? sc & 15u : sc >> 4u) + 1;
            float wd = unpackHalf2x16(load_u16(base)).x;
            UNROLL for (uint t = 0u; t < N_TOKENS; t++)
                acc[t][r] = fma(wd * yd[t] * float(ls), float(sum[t]), acc[t][r]);
        }
    }

    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u
#if Q36_BOUNDS
                && row < pc.out_dim
#endif
            )
                y[t * pc.out_dim + row] = total * pc.scale;
        }
    }
}
