#version 460
#ifdef Q36_TOKEN_PAIRS
#extension GL_GOOGLE_include_directive : require
#endif
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint wb[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };
layout(set = 0, binding = 4) readonly buffer B16 { uint b16[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint n_tok;
    uint blocks;
    uint row_bytes;
    float scale;
} pc;

#ifndef Q36_BN
#define Q36_BN 128
#endif
#if Q36_BN <= 8
#define Q36_BM (256 / Q36_BN)
#endif
#ifndef Q36_BM
#define Q36_BM 32
#endif
/* Wider tiles reuse activations across more rows, keeping each dot's K order. */
const uint BM = Q36_BM;
const uint ROWS_PER_LANE = BM / 4u;
const uint BN = Q36_BN;
const uint BK = 32u;
const uint STRIDE = BK / 2u + 1u;
const uint Q8K_WORDS = 74u;
const uint TAB_KSIGNS = 512u;
const uint TAB_IQ3XXS_GRID = 3104u;

shared f16vec2 buf_a[BM * STRIDE];
#ifdef Q36_TOKEN_PAIRS
#include "dense_token_pairs.glsl"
#else
shared f16vec2 buf_b[BN * STRIDE];
#endif
shared uint grid_lut[256];
shared uint signs_lut[32];
shared float weight_scale[BM];

uint load_u8(uint off) {
    return (wb[off >> 2u] >> ((off & 3u) * 8u)) & 255u;
}

uint load_u16(uint off) {
    return (wb[off >> 2u] >> ((off & 3u) * 8u)) & 65535u;
}

uint load_u32(uint off) {
    uint shift = (off & 3u) * 8u;
    uint word = wb[off >> 2u];
    return shift == 0u ? word :
        (word >> shift) | (wb[(off >> 2u) + 1u] << (32u - shift));
}

uint tab_u8(uint word_base, uint byte_idx) {
    return (signs_lut[byte_idx >> 2u] >> ((byte_idx & 3u) * 8u)) & 255u;
}

uint sign_mask(uint signs) {
    return (((signs & 15u) * 0x00204081u) & 0x01010101u) * 255u;
}

vec4 unpack_i8(uint v) {
    return vec4(float(bitfieldExtract(int(v), 0, 8)),
                float(bitfieldExtract(int(v), 8, 8)),
                float(bitfieldExtract(int(v), 16, 8)),
                float(bitfieldExtract(int(v), 24, 8)));
}

void main(void) {
    uint lid = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * BM;
    uint tok0 = gl_WorkGroupID.y * BN;
#if Q36_BN <= 8
    /* Each lane owns one row and two tokens; the dot keeps the large tile's K order. */
    uint lr_out = lid % BM;
    uint tok_pair = 2u * (lid / BM);
    f16vec2 sum = f16vec2(0.0);
#else
    uint wave = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint warp_row = 0u;
    uint warp_tok = wave;
    uint thread_row = lane & 3u;
    uint thread_tok = lane >> 2u;
    f16vec2 sum[2u * ROWS_PER_LANE];
    [[unroll]] for (uint i = 0u; i < 2u * ROWS_PER_LANE; i++)
        sum[i] = f16vec2(0.0);
#endif
    for (uint i = lid; i < 256u; i += 128u)
        grid_lut[i] = tables[TAB_IQ3XXS_GRID + i];
    if (lid < 32u) signs_lut[lid] = tables[TAB_KSIGNS + lid];
    barrier();

    for (uint qb = 0u; qb < pc.blocks; qb++) {
        if (lid < BM) {
            uint row = row0 + lid;
            weight_scale[lid] = row < pc.out_dim ?
                unpackHalf2x16(load_u16(row * pc.row_bytes + 98u * qb)).x *
                    (0.25 * pc.scale) : 0.0;
        }
        barrier();
        for (uint slice = 0u; slice < 8u; slice++) {
            for (uint i = lid; i < BM * 2u; i += 128u) {
                uint lr = i >> 1u;
                uint kw = i & 1u;
                uint row = row0 + lr;
                vec4 v[4];
                [[unroll]] for (uint p = 0u; p < 4u; p++) v[p] = vec4(0.0);
                if (row < pc.out_dim) {
                    uint base = row * pc.row_bytes + 98u * qb;
                    uint aux = load_u32(base + 66u + 4u * slice);
                    float d = weight_scale[lr] * float(2u * (aux >> 28u) + 1u);
                    /* One word load covers this item's four qs bytes
                     * (stride 2 from base+2+8*slice+kw). */
                    uint qs0 = load_u32(base + 2u + 8u * slice);
                    uint qs1 = load_u32(base + 6u + 8u * slice);
                    [[unroll]] for (uint p = 0u; p < 4u; p++) {
                        uint lane4 = kw + 2u * p;
                        uint qsw = p < 2u ? qs0 : qs1;
                        uint signs = tab_u8(TAB_KSIGNS,
                            (aux >> (7u * p)) & 127u);
                        uint grid = grid_lut[(qsw >> (8u * (lane4 & 3u))) & 255u];
                        uint mask = sign_mask(signs >> (4u * kw));
                        v[p] = d * unpack_i8((grid ^ mask) +
                                             (mask & 0x01010101u));
                    }
                }
                [[unroll]] for (uint p = 0u; p < 4u; p++) {
                    uint dst = lr * STRIDE + 2u * (kw + 2u * p);
                    buf_a[dst] = f16vec2(v[p].xy);
                    buf_a[dst + 1u] = f16vec2(v[p].zw);
                }
            }

#ifdef Q36_TOKEN_PAIRS
            stage_token_pairs(lid, tok0, qb, slice);
#else
            for (uint i = lid; i < BN * 2u; i += 128u) {
                uint lt = i >> 1u;
                uint kh = i & 1u;
                uint tok = tok0 + lt;
                uint dst = lt * STRIDE + 8u * kh;
                if (tok < pc.n_tok) {
                    uint src = (tok * pc.blocks + qb) * 128u +
                               slice * 16u + 8u * kh;
                    [[unroll]] for (uint j = 0u; j < 8u; j++)
                        buf_b[dst + j] = unpackFloat2x16(b16[src + j]);
                } else {
                    [[unroll]] for (uint j = 0u; j < 8u; j++)
                        buf_b[dst + j] = f16vec2(0.0);
                }
            }
#endif
            barrier();

#if Q36_BN <= 8
            [[unroll]] for (uint k = 0u; k < BK / 2u; k++) {
                f16vec2 av = buf_a[lr_out * STRIDE + k];
                f16vec2 b0 = buf_b[tok_pair * STRIDE + k];
                f16vec2 b1 = buf_b[(tok_pair + 1u) * STRIDE + k];
                sum = fma(f16vec2(av.x), f16vec2(b0.x, b1.x),
                          fma(f16vec2(av.y), f16vec2(b0.y, b1.y), sum));
            }
#else
#ifdef Q36_K_CHUNK
            /* Limit live operands without changing the order of any FMA. */
            [[dont_unroll]] for (uint kb = 0u; kb < BK / 2u; kb += Q36_K_CHUNK) {
                [[unroll]] for (uint kk = 0u; kk < Q36_K_CHUNK; kk++) {
                    uint k = kb + kk;
#else
            [[unroll]] for (uint k = 0u; k < BK / 2u; k++) {
#endif
                f16vec2 av[ROWS_PER_LANE];
                f16vec2 bv[4];
#if Q36_BM == 32
                [[unroll]] for (uint sr = 0u; sr < 2u; sr++)
                    [[unroll]] for (uint r = 0u; r < 4u; r++)
                        av[sr * 4u + r] = buf_a[(warp_row * 32u + sr * 16u +
                            thread_row * 4u + r) * STRIDE + k];
#else
                [[unroll]] for (uint r = 0u; r < ROWS_PER_LANE; r++)
                    av[r] = buf_a[(thread_row * ROWS_PER_LANE + r) * STRIDE + k];
#endif
#ifdef Q36_TOKEN_PAIRS
                [[unroll]] for (uint tp = 0u; tp < 2u; tp++) {
                    uint pair = warp_tok * 16u + tp * 8u + thread_tok;
                    bv[2u * tp] = buf_b[2u * k * B_STRIDE + pair];
                    bv[2u * tp + 1u] = buf_b[(2u * k + 1u) * B_STRIDE + pair];
                }
#else
                [[unroll]] for (uint st = 0u; st < 2u; st++)
                    [[unroll]] for (uint t = 0u; t < 2u; t++)
                        bv[st * 2u + t] = buf_b[(warp_tok * 32u + st * 16u +
                            thread_tok * 2u + t) * STRIDE + k];
#endif
                [[unroll]] for (uint tp = 0u; tp < 2u; tp++)
                    [[unroll]] for (uint rr = 0u; rr < ROWS_PER_LANE; rr++)
#ifdef Q36_TOKEN_PAIRS
                        sum[tp * ROWS_PER_LANE + rr] = fma(f16vec2(av[rr].x),
                            bv[2u * tp],
                            fma(f16vec2(av[rr].y),
                                bv[2u * tp + 1u],
                                sum[tp * ROWS_PER_LANE + rr]));
#else
                        sum[tp * ROWS_PER_LANE + rr] = fma(f16vec2(av[rr].x),
                            f16vec2(bv[2u * tp].x, bv[2u * tp + 1u].x),
                            fma(f16vec2(av[rr].y),
                                f16vec2(bv[2u * tp].y, bv[2u * tp + 1u].y),
                                sum[tp * ROWS_PER_LANE + rr]));
#endif
            }
#ifdef Q36_K_CHUNK
            }
#endif
#endif
            barrier();
        }
    }

#if Q36_BN <= 8
    uint row = row0 + lr_out;
    uint tok = tok0 + tok_pair;
    if (row < pc.out_dim) {
        if (tok < pc.n_tok) y[tok * pc.out_dim + row] = float(sum.x);
        if (tok + 1u < pc.n_tok) y[(tok + 1u) * pc.out_dim + row] = float(sum.y);
    }
#else
    [[unroll]] for (uint tt = 0u; tt < 4u; tt++) {
        uint tok = tok0 + warp_tok * 32u + (tt >> 1u) * 16u +
                   thread_tok * 2u + (tt & 1u);
        if (tok >= pc.n_tok) continue;
        [[unroll]] for (uint rr = 0u; rr < ROWS_PER_LANE; rr++) {
#if Q36_BM == 32
            uint row = row0 + warp_row * 32u + (rr >> 2u) * 16u +
                       thread_row * 4u + (rr & 3u);
#else
            uint row = row0 + thread_row * ROWS_PER_LANE + rr;
#endif
            if (row < pc.out_dim)
                y[tok * pc.out_dim + row] = float((tt & 1u) == 0u ?
                    sum[(tt >> 1u) * ROWS_PER_LANE + rr].x :
                    sum[(tt >> 1u) * ROWS_PER_LANE + rr].y);
        }
    }
#endif
}
