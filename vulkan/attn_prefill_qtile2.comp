#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

/* Each 64-lane group owns one token and its GQA heads; each lane owns
 * four output dimensions. One group avoids cross-wave barriers on BC-250. */

#ifndef Q36_QT
#define Q36_QT 2
#endif
layout(local_size_x = (64 * Q36_QT), local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Qbuf {
    float q[];
};

layout(set = 0, binding = 1) readonly buffer Kcache {
    uint kc[];
};

layout(set = 0, binding = 2) readonly buffer Vcache {
    uint vc[];
};

layout(set = 0, binding = 3) readonly buffer Sinks {
    float sinks[];
};

layout(set = 0, binding = 4) writeonly buffer Partials {
    float part[];
};

layout(push_constant) uniform Push {
    uint pos0;
    uint n_head;
    uint n_head_kv;
    uint head_dim;
    uint n_spans;
    uint n_tok;
    uint has_sinks;
    uint k_type;
    uint v_type;
    uint k_row_bytes;
    uint v_row_bytes;
    uint tok_base;
} pc;

#define TILE 64u
#define SPAN 512u
#define SPAN_GROUP 8u
#ifndef Q36_GQA_HEADS
#define Q36_GQA_HEADS 8
#endif
#define HQ Q36_GQA_HEADS
#define QT Q36_QT
#define HD 256u
#define ROWS HQ
#define VD 4u
#ifdef Q36_K_Q4
#define K_HEAD_BYTES 144u
#define K_PAIR_BYTES 36u
#else
#define K_HEAD_BYTES 272u
#define K_PAIR_BYTES 68u
#endif
#define V_HEAD_BYTES 144u

/* Keep the four 64-dimensional dot stripes in different LDS banks. */
shared float sh_q[QT * HQ * (HD + 16u)];
shared float sh_w[QT * HQ * TILE];

float dot4(vec4 a, vec4 b) {
    return dot(a, b);
}

uint qidx(uint a) {
    uint d = a % HD;
    return (a / HD) * (HD + 16u) + d + (d / 64u) * 4u;
}

/* Adjacent output dimensions share a Q4 scale and four packed bytes. */
vec4 vc_at(uint key, uint vblk, uint vqo, uint vsh) {
    uint base = key * pc.v_row_bytes + vblk;
    uint dw = vc[base >> 2u];
    float scale = unpackHalf2x16((base & 2u) == 0u ? dw : dw >> 16u).x;
    uint off = base + vqo;
    uint wi = off >> 2u;
    uint shift = (off & 3u) * 8u;
    uint bits = shift == 0u ? vc[wi] : (vc[wi] >> shift) | (vc[wi + 1u] << (32u - shift));
    return scale * (vec4(unpack8(int((bits >> vsh) & 0x0f0f0f0fu))) - vec4(8.0));
}

void main(void) {
    uint tid = gl_LocalInvocationID.x;
    uint rg = tid >> 6u;
    uint lane = tid & 63u;
    uint r0 = rg * ROWS;
    uint vi = lane * 4u;
    uint vblk = gl_WorkGroupID.x * V_HEAD_BYTES + (vi >> 5u) * 18u;
    uint vqo = 2u + (vi & 15u);
    uint vsh = (vi & 31u) < 16u ? 0u : 4u;
    uint kvh = gl_WorkGroupID.x;
    uint local0 = gl_WorkGroupID.y * QT;
    uint tok0 = pc.tok_base + local0;
    uint tn = min(QT, pc.n_tok - local0);
    uint max_n_kv = pc.pos0 + tok0 + tn;
    uint group = gl_WorkGroupID.z;
    uint span_first = group * SPAN_GROUP;
    uint max_spans = (max_n_kv + SPAN - 1u) / SPAN;
    uint span_limit = min(span_first + SPAN_GROUP, max_spans);
    if (span_first >= max_spans) return;

    uint heads = pc.n_head / pc.n_head_kv;
    uint h0 = kvh * heads;
    float scale = 1.0 / sqrt(float(HD));

    for (uint e = tid; e < QT * HQ * HD; e += 64u * QT) {
        uint r = e / HD;
        uint ti = r / HQ;
        uint j = r % HQ;
        uint d = e & (HD - 1u);
        sh_q[qidx(e)] = ti < tn && j < heads ?
            q[((tok0 + ti) * pc.n_head + h0 + j) * HD + d] : 0.0;
    }
    barrier();

    float gm[ROWS];
    float gl[ROWS];
    float gacc[ROWS][VD];
    for (uint rr = 0u; rr < ROWS; rr++) {
        gm[rr] = -3.402823466e38;
        gl[rr] = 0.0;
        for (uint v = 0u; v < VD; v++) gacc[rr][v] = 0.0;
    }

    for (uint span = span_first; span < span_limit; span++) {
        uint span0 = span * SPAN;
        uint span_end = min(span0 + SPAN, max_n_kv);
        float m[ROWS];
        float l[ROWS];
        float acc[ROWS][VD];
        float nm[ROWS];
        for (uint rr = 0u; rr < ROWS; rr++) {
            uint r = r0 + rr;
            uint ti = r / HQ;
            uint j = r % HQ;
            m[rr] = span == 0u && pc.has_sinks != 0u && ti < tn && j < heads ?
                sinks[h0 + j] : -3.402823466e38;
            l[rr] = 0.0;
            for (uint v = 0u; v < VD; v++) acc[rr][v] = 0.0;
        }

        for (uint base = span0; base < span_end; base += TILE) {
            uint tile_n = min(TILE, span_end - base);

            for (uint kt = 0u; kt < tile_n; kt += 16u) {
                uint key_t = kt + (lane >> 2u);
                uint quad = lane & 3u;
                float dots[ROWS];
                for (uint rr = 0u; rr < ROWS; rr++) dots[rr] = 0.0;
                if (key_t < tile_n) {
                    uint key = base + key_t;
                    uint kb = key * pc.k_row_bytes + kvh * K_HEAD_BYTES;
                    for (uint p = quad; p < 4u; p += 4u) {
                        uint wi = (kb + p * K_PAIR_BYTES) >> 2u;
                        uint prev = kc[wi];
                        float d0 = unpackHalf2x16(prev).x;
                        float s0[ROWS];
                        float s1[ROWS];
                        for (uint rr = 0u; rr < ROWS; rr++) {
                            s0[rr] = 0.0;
                            s1[rr] = 0.0;
                        }
#ifdef Q36_K_Q4
                        /* Match decode's low/high nibble accumulation order. */
                        for (uint k = 0u; k < 4u; k++) {
                            uint next = kc[wi + 1u + k];
                            uint sw = (prev >> 16u) | (next << 16u);
                            prev = next;
                            vec4 lo = vec4(unpack8(int(sw & 0x0f0f0f0fu))) - vec4(8.0);
                            vec4 hi = vec4(unpack8(int((sw >> 4u) & 0x0f0f0f0fu))) - vec4(8.0);
                            uint qi = p * 68u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint a = (r0 + rr) * (HD + 16u) + qi;
                                s0[rr] += dot4(lo, vec4(sh_q[a], sh_q[a + 1u], sh_q[a + 2u], sh_q[a + 3u]));
                                s0[rr] += dot4(hi, vec4(sh_q[a + 16u], sh_q[a + 17u], sh_q[a + 18u], sh_q[a + 19u]));
                            }
                        }
#else
                        for (uint k = 0u; k < 8u; k++) {
                            uint next = kc[wi + 1u + k];
                            uint sw = (prev >> 16u) | (next << 16u);
                            prev = next;
                            vec4 kv = vec4(unpack8(int(sw)));
                            uint qi = p * 68u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint qb = (r0 + rr) * (HD + 16u) + qi;
                                s0[rr] += dot4(kv, vec4(sh_q[qb], sh_q[qb + 1u],
                                                       sh_q[qb + 2u], sh_q[qb + 3u]));
                            }
                        }
#endif
                        float d1 = unpackHalf2x16(prev).y;
#ifdef Q36_K_Q4
                        for (uint k = 0u; k < 4u; k++) {
                            uint sw = kc[wi + 5u + k];
                            vec4 lo = vec4(unpack8(int(sw & 0x0f0f0f0fu))) - vec4(8.0);
                            vec4 hi = vec4(unpack8(int((sw >> 4u) & 0x0f0f0f0fu))) - vec4(8.0);
                            uint qi = p * 68u + 32u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint a = (r0 + rr) * (HD + 16u) + qi;
                                s1[rr] += dot4(lo, vec4(sh_q[a], sh_q[a + 1u], sh_q[a + 2u], sh_q[a + 3u]));
                                s1[rr] += dot4(hi, vec4(sh_q[a + 16u], sh_q[a + 17u], sh_q[a + 18u], sh_q[a + 19u]));
                            }
                        }
#else
                        for (uint k = 0u; k < 8u; k++) {
                            vec4 kv = vec4(unpack8(int(kc[wi + 9u + k])));
                            uint qi = p * 68u + 32u + 4u * k;
                            for (uint rr = 0u; rr < ROWS; rr++) {
                                uint qb = (r0 + rr) * (HD + 16u) + qi;
                                s1[rr] += dot4(kv, vec4(sh_q[qb], sh_q[qb + 1u],
                                                       sh_q[qb + 2u], sh_q[qb + 3u]));
                            }
                        }
#endif
                        for (uint rr = 0u; rr < ROWS; rr++)
                            dots[rr] += d0 * s0[rr] + d1 * s1[rr];
                    }
                }
                for (uint rr = 0u; rr < ROWS; rr++) {
                    uint r = r0 + rr;
                    uint ti = r / HQ;
                    uint n_kv = pc.pos0 + tok0 + ti + 1u;
                    float d = ti < tn && base + key_t < n_kv ? dots[rr] : 0.0;
                    d = subgroupClusteredAdd(d, 4u);
                    if ((lane & 3u) == 0u && key_t < tile_n &&
                        ti < tn && base + key_t < n_kv)
                        sh_w[r * TILE + key_t] = d * scale;
                }
            }
            barrier();

            for (uint rr = 0u; rr < ROWS; rr++) {
                uint r = r0 + rr;
                uint ti = r / HQ;
                uint n_kv = pc.pos0 + tok0 + ti + 1u;
                uint row_tile_n = ti < tn && base < n_kv ?
                    min(TILE, n_kv - base) : 0u;
                if (row_tile_n == 0u) {
                    nm[rr] = m[rr];
                    continue;
                }
                /* Reduce only the maximum; keep the softmax sum order below.
                 * 32-lane clusters also fit both wave32 and wave64 devices. */
                float tmax = -3.402823466e38;
                for (uint t = gl_SubgroupInvocationID & 31u; t < row_tile_n; t += 32u)
                    tmax = max(tmax, sh_w[r * TILE + t]);
                tmax = subgroupClusteredMax(tmax, 32u);
                float n = max(m[rr], tmax);
                float rs = exp(m[rr] - n);
                l[rr] *= rs;
                for (uint v = 0u; v < VD; v++) acc[rr][v] *= rs;
                nm[rr] = n;
            }
            barrier();

            for (uint rr = 0u; rr < ROWS; rr++) {
                uint r = r0 + rr;
                uint ti = r / HQ;
                uint n_kv = pc.pos0 + tok0 + ti + 1u;
                uint row_tile_n = ti < tn && base < n_kv ?
                    min(TILE, n_kv - base) : 0u;
                for (uint t = lane; t < row_tile_n; t += 64u)
                    sh_w[r * TILE + t] = exp(sh_w[r * TILE + t] - nm[rr]);
            }
            barrier();

            float vv[VD];
            for (uint t = 0u; t < tile_n; t++) {
                vec4 val = vc_at(base + t, vblk, vqo, vsh);
                for (uint v = 0u; v < VD; v++) vv[v] = val[v];
                for (uint rr = 0u; rr < ROWS; rr++) {
                    uint r = r0 + rr;
                    uint ti = r / HQ;
                    uint n_kv = pc.pos0 + tok0 + ti + 1u;
                    if (ti >= tn || base + t >= n_kv) continue;
                    float w = sh_w[r * TILE + t];
                    l[rr] += w;
                    for (uint v = 0u; v < VD; v++) acc[rr][v] += w * vv[v];
                }
            }
            for (uint rr = 0u; rr < ROWS; rr++) m[rr] = nm[rr];
            barrier();
        }

        for (uint rr = 0u; rr < ROWS; rr++) {
            uint r = r0 + rr;
            uint ti = r / HQ;
            uint n_kv = pc.pos0 + tok0 + ti + 1u;
            if (ti >= tn || span0 >= n_kv) continue;
            if (span == span_first) {
                gm[rr] = m[rr];
                gl[rr] = l[rr];
                for (uint v = 0u; v < VD; v++) gacc[rr][v] = acc[rr][v];
            } else {
                float n = max(gm[rr], m[rr]);
                float rp = exp(gm[rr] - n);
                float rs = exp(m[rr] - n);
                gl[rr] = gl[rr] * rp + l[rr] * rs;
                for (uint v = 0u; v < VD; v++)
                    gacc[rr][v] = gacc[rr][v] * rp + acc[rr][v] * rs;
                gm[rr] = n;
            }
        }
        barrier();
    }

    for (uint rr = 0u; rr < ROWS; rr++) {
        uint r = r0 + rr;
        uint ti = r / HQ;
        uint j = r % HQ;
        uint tok = tok0 + ti;
        uint n_kv = pc.pos0 + tok + 1u;
        uint row_spans = (n_kv + SPAN - 1u) / SPAN;
        if (ti >= tn || j >= heads || span_first >= row_spans) continue;
        uint pbase = (((local0 + ti) * pc.n_head + h0 + j) *
                      pc.n_spans + group) * (HD + 2u);
        for (uint v = 0u; v < VD; v++)
            part[pbase + vi + v] = gacc[rr][v];
        if (lane == 0u) {
            part[pbase + HD] = gm[rr];
            part[pbase + HD + 1u] = gl[rr];
        }
    }
}
