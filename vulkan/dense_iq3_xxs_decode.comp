#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#ifndef Q36_WAVES
#define Q36_WAVES 1
#endif
/* Independent 64-lane rows share the grid while keeping fewer values live. */
layout(local_size_x = 64 * Q36_WAVES, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint16_t wh[]; };
layout(set = 0, binding = 1) readonly buffer Q8K { uint q8[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 3) readonly buffer Tables { uint tables[]; };

#ifndef Q36_TOKENS
#define Q36_TOKENS 1
#endif

#if Q36_TOKENS > 1
layout(constant_id = 0) const uint N_TOKENS = Q36_TOKENS;
#else
#define N_TOKENS 1
#endif

#define UNROLL [[unroll]]

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint row_bytes;
    float scale;
#if Q36_TOKENS > 1
    uint n_tok;
#endif
} pc;

#ifndef Q36_ROWS
#define Q36_ROWS 5
#endif
#ifndef Q36_BOUNDS
#define Q36_BOUNDS 1
#endif
const uint ROWS = Q36_ROWS;
const uint Q8K_WORDS = 74u;
const uint TAB_IQ3XXS_GRID = 3104u;

shared uint grid_lut[256];
shared uvec2 sign_lut[16];

uint load_u8(uint off) {
    return (uint(wh[off >> 1u]) >> ((off & 1u) * 8u)) & 255u;
}

uint load_u16(uint off) {
    return uint(wh[off >> 1u]);
}

uint load_u32(uint off) {
    uint i = off >> 1u;
    return uint(wh[i]) | (uint(wh[i + 1u]) << 16u);
}

int signed_bytes(uint grid, uint signs) {
    uvec2 mask = sign_lut[signs & 15u];
    return int((grid ^ mask.x) + mask.y);
}

void main(void) {
    uint lid = gl_LocalInvocationID.x & 63u;
    uint itid = lid & 7u;
    uint first_row = (gl_WorkGroupID.x * Q36_WAVES +
                      gl_LocalInvocationID.x / 64u) * ROWS;
    float acc[N_TOKENS][ROWS];
    UNROLL for (uint t = 0u; t < N_TOKENS; t++)
        UNROLL for (uint r = 0u; r < ROWS; r++) acc[t][r] = 0.0;
    UNROLL for (uint i = gl_LocalInvocationID.x; i < 256u; i += 64u * Q36_WAVES)
        grid_lut[i] = tables[TAB_IQ3XXS_GRID + i];
    /* Build each byte mask once instead of spreading signs for every grid. */
    if (gl_LocalInvocationID.x < 16u) {
        uint bits = (lid * 0x00204081u) & 0x01010101u;
        sign_lut[lid] = uvec2(bits * 255u, bits);
    }
    barrier();

    for (uint b = lid >> 3u; b < pc.blocks; b += 8u) {
        uint qbase = b * Q8K_WORDS;
        int qv[N_TOKENS][8];
        float yd[N_TOKENS];
        UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
            uint offset = t * pc.blocks * Q8K_WORDS;
            UNROLL for (uint l = 0u; l < 8u; l++) qv[t][l] = int(q8[offset + qbase + 2u + 8u * itid + l]);
            yd[t] = uintBitsToFloat(q8[offset + qbase]);
        }
        uint ib = itid;

        UNROLL for (uint r = 0u; r < ROWS; r++) {
            uint row = first_row + r;
#if Q36_BOUNDS
            if (row >= pc.out_dim) continue;
#endif
            uint base = row * pc.row_bytes + 98u * b;
            uint aux = load_u32(base + 66u + 4u * ib);
            /* These 32 byte products sum exactly in f32; packed integer dots
             * preserve the decode result before applying float scales. */
            int sum[N_TOKENS];
            UNROLL for (uint t = 0u; t < N_TOKENS; t++) sum[t] = 0;
            UNROLL for (uint part = 0u; part < 2u; part++) {
                uint qs = load_u32(base + 2u + 8u * ib + 4u * part);
                UNROLL for (uint l = 0u; l < 2u; l++) {
                    uint signs =
                        (aux >> (7u * (2u * part + l))) & 127u;
                    uint parity = bitCount(signs) & 1u;
                    uint grid0 = grid_lut[(qs >> (16u * l)) & 255u];
                    uint grid1 = grid_lut[(qs >> (16u * l + 8u)) & 255u];
                    int w0 = signed_bytes(grid0, signs);
                    int w1 = signed_bytes(grid1, (signs >> 4u) | (parity << 3u));
                    uint q = 4u * part + 2u * l;
                    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
                        sum[t] += dotPacked4x8EXT(w0, qv[t][q]);
                        sum[t] += dotPacked4x8EXT(w1, qv[t][q + 1u]);
                    }
                }
            }
            int ls = 2 * int(aux >> 28u) + 1;
            float wd = unpackHalf2x16(load_u16(base)).x;
            UNROLL for (uint t = 0u; t < N_TOKENS; t++)
                acc[t][r] = fma(wd * yd[t] * float(ls), float(sum[t]), acc[t][r]);
        }
    }

    UNROLL for (uint t = 0u; t < N_TOKENS; t++) {
        UNROLL for (uint r = 0u; r < ROWS; r++) {
            float total = subgroupAdd(acc[t][r]);
            uint row = first_row + r;
            if (lid == 0u
#if Q36_BOUNDS
                && row < pc.out_dim
#endif
            )
                y[t * pc.out_dim + row] = total * (0.25 * pc.scale);
        }
    }
}
