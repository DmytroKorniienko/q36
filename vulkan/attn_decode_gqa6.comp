#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#ifdef Q36_GQA8
#define qvec vec4
#define GROUP 4u
#define GQA 8u
#else
#define qvec vec3
#define GROUP 3u
#define GQA 6u
#endif

/* Adjacent heads share one GQA key/value stream. Each vector lane
 * keeps the split kernel's scalar reduction and softmax order. */
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Q {
    float q[];
};
layout(set = 0, binding = 1) readonly buffer K {
    uint kc[];
};
layout(set = 0, binding = 2) readonly buffer V {
    uint vc[];
};
layout(set = 0, binding = 3) readonly buffer Sinks {
    float sinks[];
};
layout(set = 0, binding = 4) writeonly buffer Partials {
    float part[];
};
layout(push_constant) uniform Push {
    uint pos0, n_head, n_head_kv, head_dim, n_spans, has_sinks, k_type, v_type, k_row_bytes,
        v_row_bytes;
} pc;
shared float sh_q[256u * GROUP];
shared qvec sh_w[64];

qvec qdot(uint word, uint qi) {
    vec4 k = vec4(unpack8(int(word)));
    return qvec(dot(k, vec4(sh_q[qi], sh_q[qi + 1u], sh_q[qi + 2u], sh_q[qi + 3u])),
                dot(k, vec4(sh_q[qi + 256u], sh_q[qi + 257u], sh_q[qi + 258u], sh_q[qi + 259u])),
                dot(k, vec4(sh_q[qi + 512u], sh_q[qi + 513u], sh_q[qi + 514u], sh_q[qi + 515u]))
#ifdef Q36_GQA8
                , dot(k, vec4(sh_q[qi + 768u], sh_q[qi + 769u], sh_q[qi + 770u], sh_q[qi + 771u]))
#endif
                );
}

#ifdef Q36_K_Q4
qvec qdot4(uint word, uint qi) {
    vec4 k = vec4(unpack8(int(word))) - vec4(8.0);
    return qvec(dot(k, vec4(sh_q[qi], sh_q[qi + 1u], sh_q[qi + 2u], sh_q[qi + 3u])),
                dot(k, vec4(sh_q[qi + 256u], sh_q[qi + 257u], sh_q[qi + 258u], sh_q[qi + 259u])),
                dot(k, vec4(sh_q[qi + 512u], sh_q[qi + 513u], sh_q[qi + 514u], sh_q[qi + 515u]))
#ifdef Q36_GQA8
                , dot(k, vec4(sh_q[qi + 768u], sh_q[qi + 769u], sh_q[qi + 770u], sh_q[qi + 771u]))
#endif
                );
}

const uint K_PAIR_BYTES = 36u;
#else
const uint K_PAIR_BYTES = 68u;
#endif

qvec kdot(uint b, uint p) {
#ifdef Q36_K_Q4
    uint wi = b >> 2u, prev = kc[wi];
    float d0 = unpackHalf2x16(prev).x;
    qvec s0 = qvec(0.0);
    for (uint k = 0u; k < 4u; k++) {
        uint next = kc[wi + 1u + k];
        uint sw = (prev >> 16u) | (next << 16u);
        prev = next;
        uint qi = p * 64u + 4u * k;
        s0 += qdot4(sw & 0x0f0f0f0fu, qi);
        s0 += qdot4((sw >> 4u) & 0x0f0f0f0fu, qi + 16u);
    }
    float d1 = unpackHalf2x16(prev).y;
    qvec s1 = qvec(0.0);
    for (uint k = 0u; k < 4u; k++) {
        uint sw = kc[wi + 5u + k];
        uint qi = p * 64u + 32u + 4u * k;
        s1 += qdot4(sw & 0x0f0f0f0fu, qi);
        s1 += qdot4((sw >> 4u) & 0x0f0f0f0fu, qi + 16u);
    }
    return d0 * s0 + d1 * s1;
#else
    uint wi = b >> 2u, prev = kc[wi];
    float d0 = unpackHalf2x16(prev).x;
    qvec s0 = qvec(0.0);
    for (uint k = 0u; k < 8u; k++) {
        uint next = kc[wi + 1u + k];
        uint sw = (prev >> 16u) | (next << 16u);
        prev = next;
        s0 += qdot(sw, p * 64u + 4u * k);
    }
    float d1 = unpackHalf2x16(prev).y;
    qvec s1 = qvec(0.0);
    for (uint k = 0u; k < 8u; k++)
        s1 += qdot(kc[wi + 9u + k], p * 64u + 32u + 4u * k);
    return d0 * s0 + d1 * s1;
#endif
}

float v_q4(uint t, uint vblk, uint vqo, uint vsh) {
    uint b = t * pc.v_row_bytes + vblk;
    uint dw = vc[b >> 2u];
    float d = unpackHalf2x16((b & 2u) == 0u ? dw : (dw >> 16u)).x;
    uint qb = b + vqo;
    uint qv = (vc[qb >> 2u] >> (((qb & 3u) * 8u) + vsh)) & 15u;
    return d * float(int(qv) - 8);
}

void main() {
    uint tid = gl_LocalInvocationID.x, h = GROUP * gl_WorkGroupID.x, tok = gl_WorkGroupID.y,
         span = gl_WorkGroupID.z;
    uint n_kv = pc.pos0 + tok + 1u, span0 = span * 512u, span_end = min(span0 + 512u, n_kv);
    uint pbase = ((tok * pc.n_head + h) * pc.n_spans + span) * 258u;
    uint pnext = pbase + pc.n_spans * 258u;
    uint plast = pnext + pc.n_spans * 258u;
    if (span0 >= n_kv)
        return;
    uint kvh = h / GQA;
    sh_q[tid] = q[(tok * pc.n_head + h) * 256u + tid];
    sh_q[tid + 256u] = q[(tok * pc.n_head + h + 1u) * 256u + tid];
    sh_q[tid + 512u] = q[(tok * pc.n_head + h + 2u) * 256u + tid];
#ifdef Q36_GQA8
    sh_q[tid + 768u] = q[(tok * pc.n_head + h + 3u) * 256u + tid];
#endif
    barrier();
#ifdef Q36_GQA8
    qvec m = span == 0u && pc.has_sinks != 0u ? qvec(sinks[h], sinks[h + 1u], sinks[h + 2u], sinks[h + 3u])
                                              : qvec(-3.402823466e38);
#else
    qvec m = span == 0u && pc.has_sinks != 0u ? qvec(sinks[h], sinks[h + 1u], sinks[h + 2u])
                                              : qvec(-3.402823466e38);
#endif
    qvec l = qvec(0.0), acc = qvec(0.0);
    uint vblk = kvh * 144u + (tid >> 5u) * 18u;
    uint vqo = 2u + (tid & 15u), vsh = (tid & 31u) < 16u ? 0u : 4u;
    for (uint base = span0; base < span_end; base += 64u) {
        uint tile_n = min(64u, span_end - base), key = base + (tid >> 2u), quad = tid & 3u;
        qvec dot = qvec(0.0);
        if ((tid >> 2u) < tile_n)
            dot += kdot(key * pc.k_row_bytes + kvh * (4u * K_PAIR_BYTES) + quad * K_PAIR_BYTES, quad);
        dot = subgroupClusteredAdd(dot, 4u);
        if (quad == 0u && (tid >> 2u) < tile_n)
            sh_w[tid >> 2u] = dot * 0.0625;
        barrier();
        qvec tmax = qvec(-3.402823466e38);
        for (uint t = gl_SubgroupInvocationID & 31u; t < tile_n; t += 32u)
            tmax = max(tmax, sh_w[t]);
        tmax = subgroupClusteredMax(tmax, 32u);
        qvec nm = max(m, tmax), r = exp(m - nm);
        l *= r;
        acc *= r;
        barrier();
        if (tid < tile_n)
            sh_w[tid] = exp(sh_w[tid] - nm);
        barrier();
        uint t = 0u;
        for (; t + 4u <= tile_n; t += 4u) {
            qvec w0 = sh_w[t], w1 = sh_w[t + 1u], w2 = sh_w[t + 2u], w3 = sh_w[t + 3u];
            float v0 = v_q4(base + t, vblk, vqo, vsh), v1 = v_q4(base + t + 1u, vblk, vqo, vsh);
            float v2 = v_q4(base + t + 2u, vblk, vqo, vsh),
                  v3 = v_q4(base + t + 3u, vblk, vqo, vsh);
            l += w0;
            acc += w0 * v0;
            l += w1;
            acc += w1 * v1;
            l += w2;
            acc += w2 * v2;
            l += w3;
            acc += w3 * v3;
        }
        for (; t < tile_n; t++) {
            qvec w = sh_w[t];
            l += w;
            acc += w * v_q4(base + t, vblk, vqo, vsh);
        }
        m = nm;
        barrier();
    }
    part[pbase + tid] = acc.x;
    part[pnext + tid] = acc.y;
    part[plast + tid] = acc.z;
#ifdef Q36_GQA8
    uint pextra = plast + pc.n_spans * 258u;
    part[pextra + tid] = acc.w;
#endif
    if (tid == 0u) {
        part[pbase + 256u] = m.x;
        part[pbase + 257u] = l.x;
        part[pnext + 256u] = m.y;
        part[pnext + 257u] = l.y;
        part[plast + 256u] = m.z;
        part[plast + 257u] = l.z;
#ifdef Q36_GQA8
        part[pextra + 256u] = m.w;
        part[pextra + 257u] = l.w;
#endif
    }
}
